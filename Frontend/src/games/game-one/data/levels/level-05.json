  "questions": [
    {
      "id": "for-loop-gate",
      "topic": "for loop",
      "formattedQuestion": "for (int i = 0; i < 4; i++)\n\nHow many times will this loop run?",
      "prompt": "How many times does for (int i = 0; i < 4; i++) run?",
      "choices": [
        "3",
        "4",
        "5"
      ],
      "answerIndex": 1,
      "successText": "Correct! The FOR Loop Gate opens.",
      "failureText": "Incorrect. Count the values of i and try again.",
      "damageOnWrongAnswer": 0
    },
    {
      "id": "while-loop-gate",
      "topic": "while loop",
      "formattedQuestion": "int health = 3;\nwhile (health > 0) { health--; }\n\nWhen will the loop stop?",
      "prompt": "When will the loop stop?",
      "choices": [
        "When health becomes 0",
        "When health becomes 2",
        "It never stops"
      ],
      "answerIndex": 0,
      "successText": "Correct! The WHILE Gate opens.",
      "failureText": "Incorrect. Trace the loop and try again.",
      "damageOnWrongAnswer": 0
    },
    {
      "id": "do-while-loop-gate",
      "topic": "do-while loop",
      "formattedQuestion": "int x = 10;\ndo { x++; } while (x < 5);\n\nWill the loop body execute?",
      "prompt": "Will this do-while loop body execute?",
      "choices": [
        "YES",
        "NO"
      ],
      "answerIndex": 0,
      "successText": "Correct! A do-while body executes before checking.",
      "failureText": "Incorrect. Remember when a do-while checks its condition.",
      "damageOnWrongAnswer": 0
    },
    {
      "id": "trial-for",
      "topic": "Loop Trial: FOR",
      "prompt": "How many times does for (int i = 1; i <= 3; i++) execute?",
      "choices": [
        "2",
        "3",
        "4"
      ],
      "answerIndex": 1,
      "successText": "Correct! Loop Gate 1 opens.",
      "failureText": "Incorrect. Trace the loop and try again.",
      "damageOnWrongAnswer": 0
    },
    {
      "id": "trial-while",
      "topic": "Loop Trial: WHILE",
      "formattedQuestion": "int x = 2;\nwhile (x < 5) { x++; }",
      "prompt": "What is the final value of x?",
      "choices": [
        "4",
        "5",
        "6"
      ],
      "answerIndex": 1,
      "successText": "Correct! Loop Gate 2 opens.",
      "failureText": "Incorrect. Trace the loop and try again.",
      "damageOnWrongAnswer": 0
    },
    {
