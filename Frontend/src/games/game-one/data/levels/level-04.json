    {
      "id": "if-condition-gate",
      "topic": "if statement",
      "formattedQuestion": "int score = 10;\nscore >= 5\n\nIs the condition true or false?",
      "prompt": "Is score >= 5 true when score is 10?",
      "choices": [
        "TRUE",
        "FALSE"
      ],
      "answerIndex": 0,
      "successText": "Correct! The IF path opens.",
      "failureText": "Incorrect. Check the condition again.",
      "damageOnWrongAnswer": 0
    },
    {
      "id": "else-path-gate",
      "topic": "if-else statement",
      "formattedQuestion": "int coins = 3;\ncoins >= 5\n\nWhich path will Java execute?",
      "prompt": "Which path executes when coins is 3 and the condition is coins >= 5?",
      "choices": [
        "IF",
        "ELSE"
      ],
      "answerIndex": 1,
      "successText": "Correct! Java follows the ELSE path.",
      "failureText": "That condition is false. Choose the path Java would execute.",
      "damageOnWrongAnswer": 0
    },
    {
      "id": "else-if-path-gate",
      "topic": "else-if statement",
      "formattedQuestion": "int score = 82;\nGate A: score >= 90\nGate B: score >= 75\nGate C: else",
      "prompt": "For score = 82, which branch is selected first?",
      "choices": [
        "Gate A",
        "Gate B",
        "Gate C"
      ],
      "answerIndex": 1,
      "successText": "Correct! Gate B is the first true branch.",
      "failureText": "Incorrect. Evaluate the conditions from top to bottom.",
      "damageOnWrongAnswer": 0
    },
    {
      "id": "decision-if",
      "topic": "Decision Trial: IF",
      "prompt": "Will the if block execute when health is 8 and health > 5?",
      "choices": [
        "YES",
