      "formattedQuestion": "int score = 70;\n>= 90: Gold\n>= 75: Silver\n>= 60: Bronze\nelse: No Reward",
      "prompt": "For score = 70, which result does Java choose?",
      "choices": [
        "Gold",
        "Silver",
